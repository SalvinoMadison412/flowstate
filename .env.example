# Supabase — used by the lead-capture form (lib/leads.ts) and the CRM
# Project: FlowState (ref ogzxvbmzyvqcspupxhak)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Twilio dialer (app/api/twilio/*, chrome-extension/) ──────────────────────
# Only needed on the deployment that serves the softphone. See DIALER_SETUP.md.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+16292818264
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-twilio-api-secret

# Exact public origin registered as the TwiML App voice URL, e.g.
# https://crm.flowstate.agency  — used to verify the X-Twilio-Signature.
TWILIO_PUBLIC_URL=https://your-crm-domain.com
# During tunnel-based setup only; never leave true in production.
# TWILIO_SKIP_SIGNATURE_CHECK=false

# Optional overrides (sensible defaults in lib/twilioServer.ts)
# CRM_OWNER_EMAIL=salvinokevin7@gmail.com
# TWILIO_DIALER_IDENTITY=flowstate-owner
# DIALER_EXTENSION_ORIGIN=chrome-extension://<your unpacked extension id>
